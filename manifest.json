{
    "manifest_version": 3,
    "name": "PhishShield",
    "version": "0.1.0",
    "description": "An extra protection layer that blocks configured phishing test domains.",
    "icons": {
        "16": "icons/phishshield-16.png",
        "32": "icons/phishshield-32.png",
        "48": "icons/phishshield-48.png",
        "128": "icons/phishshield-128.png"
    },
    "permissions": [
        "declarativeNetRequest",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "web_accessible_resources": [
        {
            "resources": [
                "blocked/blocked.html",
                "blocked/blocked.css",
                "blocked/blocked.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_title": "PhishShield",
        "default_icon": {
            "16": "icons/phishshield-16.png",
            "32": "icons/phishshield-32.png"
        },
        "default_popup": "popup/popup.html"
    }
}
